# Dependencies — huge, and always reproducible from package.json + npm install
node_modules/

# Build output — regenerated by `npm run build`, never hand-edited
dist/

# electron-builder's packaged app output — regenerated by `npm run package`
release/

# Environment variables, if any get added later (API keys, secrets)
.env
.env.local
.env.*.local

# npm/yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-generated files
.DS_Store
Thumbs.db

# Editor folders (personal settings, not shared project config)
.vscode/
.idea/